# Data directories (large files, should not be in git)
data/
reports/

# Customer deliveries contain client site coordinates and asset inventories. They are
# generated artifacts, reproducible from the input CSV plus the processed layers, and they
# do not belong in version control.
deliveries/

# NetCDF data files
*.nc
*.nc4
*.zarr/

# Claude Code local settings — machine-specific, not shared.
# NOTE: match the CONTENTS (.claude/*), not the directory (.claude/). Git does not
# descend into an excluded directory, so an excluded `.claude/` would make the
# skills re-inclusion below silently ineffective.
.claude/*

# ...but the ISIMIP skills ARE shared project knowledge and must be version
# controlled. They previously lived in the untracked ~/.claude/skills/, were
# stripped out of CLAUDE.md by ce48826, and were lost when the environment
# changed. Keep them in the repo.
!.claude/skills/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE settings
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
nul

# Logs
*.log

# Temporary files
*.tmp
*.bak

# Test outputs
.pytest_cache/
.coverage
htmlcov/
